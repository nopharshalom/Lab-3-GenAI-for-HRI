# Copy to .env and fill in what you need.

# Your robot's IP (leave empty to let the SDK find it)
ROBOT_IP=

# 1 = OpenAI models + OpenAI voice, 0 = free Ollama model on your laptop
LEGO_COACH_API=0
OPENAI_API_KEY=sk-...

# Override the model (defaults: gemma3:4b with Ollama, the course default with the API)
# VLM_MODEL=gemma3:12b

# Optional: a MediaPipe object detector you trained on LEGO bricks
# LEGO_DETECTOR_MODEL=/path/to/lego_detector.tflite
